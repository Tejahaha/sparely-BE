{
  "name": "@sparely/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sparely Node HTTP API with PostgreSQL persistence and isolated SQLite tests",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "node ../scripts/dev.mjs --backend",
    "start": "node --env-file-if-exists=.env main.mjs",
    "check": "node scripts/check.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test": "node --test --test-force-exit --test-timeout=120000 test/*.test.mjs",
    "init:db": "node --env-file-if-exists=.env scripts/init-db.mjs",
    "migrate:postgres": "node --env-file-if-exists=.env scripts/migrate-postgres.mjs",
    "build:function": "node scripts/build-function.mjs",
    "db:status": "node --env-file-if-exists=.env scripts/db-tools.mjs status",
    "db:backup": "node --env-file-if-exists=.env scripts/db-tools.mjs backup",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-tools.mjs migrate",
    "db:restore-check": "node --env-file-if-exists=.env scripts/db-tools.mjs restore-check",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs",
    "ollama:gateway": "node --env-file-if-exists=.env.ollama-gateway scripts/ollama-gateway.mjs",
    "db:prune": "node scripts/prune-backups.mjs"
  },
  "dependencies": {
    "@neon/functions": "^0.11.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
