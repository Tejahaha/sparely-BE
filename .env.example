PORT=4173
# Server-only PostgreSQL URL. Leave empty only for an explicitly initialized local SQLite installation.
DATABASE_URL=
# Only enable on networks whose DNS refuses Neon hosts. TLS hostname verification remains on.
NEON_DNS_FALLBACK=0
# Optional AI helpers (search, reminder wording, message translation) on a self-hosted model.
# Local development: LLM_URL=http://<ollama-lan-ip>:11434
# Vercel: use the authenticated HTTPS gateway in OLLAMA_PRODUCTION.md instead.
# Leave LLM_URL empty to turn AI off; every feature then uses its non-AI path.
# Check speed and answers first: node --env-file=.env scripts/llm-check.mjs
LLM_URL=
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_MS=15000
# Hosted provider key, or the token of the authenticated Ollama gateway.
LLM_API_KEY=
# Keep the shared demo off for a public API unless the whole deployment is gated.
SPARELY_DEMO=off
# Mark HTTPS sessions Secure when the API sits behind a trusted HTTPS proxy.
COOKIE_SECURE=1
# Hosting: set HOST=0.0.0.0 so the platform can reach the server (default 127.0.0.1).
HOST=
# Exact browser origins allowed besides the server's own, comma-separated.
# Remote frontend dev via Vite proxy: http://127.0.0.1:5173
ALLOWED_ORIGINS=
# Server-only hosted API settings. Never prefix these with VITE_.
NEON_FUNCTION_URL=
ORIGIN_SECRET=
# Exact HTTPS frontend origin in hosted proxy deployments; omit for localhost dev.
APP_ORIGIN=
# If an external scheduler calls the Vercel watchdog endpoint, use a separate
# random 32+ byte value and schedule every five minutes.
CRON_SECRET=
# Vercel Pro: set to */5 * * * * for the scheduled watchdog. Hobby requires
# an external scheduler calling GET /api/cron with Authorization: Bearer CRON_SECRET.
SPARELY_CRON_SCHEDULE=
